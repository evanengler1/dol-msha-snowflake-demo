# Copy to .env.local (git-ignored).
# Name of the connection in ~/.snowflake/connections.toml (or config.toml) to use for local dev.
SNOWFLAKE_CONNECTION_NAME=<your-connection>
SNOWFLAKE_ROLE=DOL_MSHA_DEMO_ROLE
SNOWFLAKE_WAREHOUSE=DOL_MSHA_WH
# Snowsight URL of the Streamlit dashboard (header and home-page link). Optional.
NEXT_PUBLIC_DASHBOARD_URL=
