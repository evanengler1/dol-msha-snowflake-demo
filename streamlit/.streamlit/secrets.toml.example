# Copy to secrets.toml (git-ignored) to run the dashboard locally with `streamlit run Overview.py`.
# Not used when deployed: Streamlit in Snowflake supplies the session.
[connections.snowflake]
account = "<ORGNAME-ACCOUNTNAME>"
user = "<your-user>"
authenticator = "externalbrowser"   # or oauth_authorization_code, key pair, etc.
role = "DOL_MSHA_DEMO_ROLE"
warehouse = "DOL_MSHA_WH"
database = "DOL_MSHA_DEMO"
schema = "ANALYTICS"
client_store_temporary_credential = true
